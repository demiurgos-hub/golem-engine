{
  "name": "golem-threlte",
  "version": "0.3.1",
  "description": "Typed Svelte and Threlte presentation for persistent Golem clients",
  "license": "Apache-2.0",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "svelte": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./threlte": { "types": "./dist/threlte.d.ts", "svelte": "./dist/threlte.js" }
  },
  "sideEffects": false,
  "scripts": {
    "prebuild": "npm --prefix ../golem-js run build",
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run build && npm run check && node --test test/*.test.js && vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "golem-engine": ">=0.3.1 <0.4.0",
    "svelte": "^5.57.1",
    "@threlte/core": "^8.6.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "golem-engine": "file:../golem-js",
    "svelte": "5.57.1",
    "@threlte/core": "8.6.1",
    "three": "0.186.1",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "svelte-check": "4.7.6",
    "@sveltejs/package": "2.5.8",
    "vite": "8.3.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "vitest": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "playwright": "^1.58.0"
  }
}
